      "Bash(curl -s -o /tmp/session.json -w \"session: %{http_code}\\\\n\" http://localhost:3010/api/auth/session)",
      "Read(//tmp/**)",
      "Bash(npm install *)",
      "Bash(npx eslint *)"
    ]
  }
}
